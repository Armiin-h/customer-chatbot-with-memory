# Backend
# Local uvicorn: http://localhost:11434
# Docker Compose API container: forced to http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# History window size (number of message turns kept in context)
MEMORY_WINDOW_SIZE=10
# SQLite path for conversation history
DATABASE_URL=sqlite:///./data/chat_history.db

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend (Vite local dev). Docker build ignores this and uses /api via nginx.
VITE_API_BASE_URL=http://localhost:8000
